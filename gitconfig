[core]
  excludesfile = ~/.gitignore
  editor = nvim

[alias]
  st = status
  ci = commit
  cm = commit -am
  br = checkout -b
  co = checkout
  df = diff
  lg = log -p
  aa = add .
  p  = push
  u  = up

[push]
  followTags = true
[init]
	defaultBranch = master
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
